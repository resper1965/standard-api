{
  "name": "standard-api-standard",
  "private": true,
  "version": "1.2.2",
  "description": "API-first standard implementation of the Standard SCF-Based Assessment Lifecycle.",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "prepare": "node -e \"if(process.env.NODE_ENV==='production'){process.exit(0)}process.exit(1)\" || husky",
    "dev": "pnpm dev:api",
    "build": "pnpm -r --if-present build",
    "lint": "node scripts/lint.mjs && pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm -r --if-present --filter \"./packages/*\" test",
    "test:integration": "pnpm --filter @standard/api-gateway test && pnpm --filter @standard/workflows test",
    "test:contracts": "tsx tests/contracts/run-tests.ts",
    "test:security": "pnpm --filter @standard/security test && pnpm --filter @standard/api-gateway test",
    "test:evaluations": "tsx evals/run-evals.ts",
    "test:regression": "tsx evals/regression/run-regression.ts",
    "test:synthetic-e2e": "tsx tests/e2e-synthetic/run-tests.ts",
    "test:ci": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:contracts && pnpm test:security && pnpm test:regression && pnpm test:evaluations && pnpm test:synthetic-e2e && pnpm build",
    "db:generate": "pnpm --filter @standard/schemas db:generate",
    "db:migrate": "pnpm --filter @standard/schemas db:migrate",
    "dev:api": "pnpm --filter @standard/api-gateway dev",
    "dev:workflows": "pnpm --filter @standard/workflows dev",
    "dev:queues": "pnpm --filter @standard/queues dev",
    "dev:ingestion": "pnpm --filter @standard/ingestion-worker dev",
    "dev:web": "pnpm --filter @standard/web dev",
    "cf:dev": "pnpm dev:api",
    "cf:deploy:staging": "node scripts/deploy-cloudflare.mjs staging",
    "cf:deploy:production": "node scripts/deploy-cloudflare.mjs production",
    "db:seed": "pnpm --filter @standard/schemas db:seed",
    "db:seed:scf": "pnpm --filter @standard/schemas db:seed:scf",
    "db:seed:strm": "pnpm --filter @standard/schemas db:seed:strm",
    "db:seed:strm:dry-run": "pnpm --filter @standard/schemas db:seed:strm:dry-run",
    "db:studio": "pnpm --filter @standard/schemas exec drizzle-kit studio --config drizzle.config.ts"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^10.0.1",
    "@sentry/cli": "^3.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.7.0",
    "eslint": "10.4.0",
    "husky": "^9.0.11",
    "js-yaml": "^4.2.0",
    "lint-staged": "^15.2.2",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.21.2",
    "wrangler": "^4.95.0",
    "zod": "^4.4.0"
  },
  "dependencies": {
    "better-auth": "1.6.14",
    "dotenv": "^17.4.2"
  },
  "pnpm": {
    "overrides": {
      "better-auth": "1.6.14",
      "uuid": ">=11.1.1",
      "i18next": "^25.1.0",
      "mysql2": "^3.22.0",
      "zod": "^4.4.0",
      "astro": "^6.3.3",
      "undici": "^7.0.0",
      "ws": ">=8.17.1",
      "@electric-sql/pglite": "0.5.1",
      "cross-spawn": ">=7.0.6",
      "yaml": ">=2.8.3",
      "vite": ">=6.4.2",
      "@hono/node-server": ">=1.19.13",
      "hono": ">=4.12.25",
      "esbuild": ">=0.28.1",
      "drizzle-orm": "0.45.2",
      "@neondatabase/serverless": "1.1.0"
    }
  }
}
