{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "zod": ["node_modules/zod/v4/classic"],
      "zod/v4": ["node_modules/zod/v4"],
      "@standard/workflows": ["workers/workflows/src/orchestrator-entry.ts"],
      "@standard/workflows/*": ["workers/workflows/src/*"],
      "@standard/*": ["packages/*/src/index.ts"]
    }
  }
}
