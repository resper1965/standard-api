NODE_ENV=development
STANDARD_ENV=local
LOG_LEVEL=info

# Local PostgreSQL only. Staging/production must use managed PostgreSQL secrets.
DATABASE_URL=postgres://standard:standard_dev_password@localhost:5432/standard

# Cloudflare placeholders. Never commit real account IDs or tokens.
CLOUDFLARE_ACCOUNT_ID=__CLOUDFLARE_ACCOUNT_ID__
CLOUDFLARE_API_TOKEN=__CLOUDFLARE_API_TOKEN__

# R2/S3-compatible placeholders for local tools only.
R2_ACCESS_KEY_ID=__R2_ACCESS_KEY_ID__
R2_SECRET_ACCESS_KEY=__R2_SECRET_ACCESS_KEY__
R2_ENDPOINT=__R2_ENDPOINT__

# AI Gateway placeholders.
AI_GATEWAY_ACCOUNT_ID=__AI_GATEWAY_ACCOUNT_ID__
AI_GATEWAY_NAME=standard-dev
AI_GATEWAY_BASE_URL=__AI_GATEWAY_BASE_URL__

# Future provider placeholder. Leave empty unless explicitly configured.
OPENAI_API_KEY=__OPENAI_API_KEY__

# Standard Native Auth (session-based authentication).
BETTER_AUTH_SECRET=__BETTER_AUTH_SECRET__
BETTER_AUTH_URL=http://localhost:8787

# Local/dev Vectorize placeholder.
VECTORIZE_INDEX_NAME=standard-kb-dev

