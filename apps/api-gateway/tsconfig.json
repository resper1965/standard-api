{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "typeRoots": ["../../node_modules", "./node_modules"],
    "exactOptionalPropertyTypes": false,
    "paths": {
      "zod": ["../../node_modules/zod/v4/classic"],
      "zod/v4": ["../../node_modules/zod/v4"],
      "@standard/workflows": ["../../workers/workflows/src/orchestrator-entry.ts"],
      "@standard/workflows/*": ["../../workers/workflows/src/*"],
      "@standard/*": ["../../packages/*/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**"]
}
