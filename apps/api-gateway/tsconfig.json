{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "exactOptionalPropertyTypes": false,
    "paths": {
                  "@standard/workflows": ["../../workers/workflows/src/orchestrator-entry.ts"],
      "@standard/workflows/*": ["../../workers/workflows/src/*"],
      "@standard/*": ["../../packages/*/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**"]
}
