{
  "name": "@standard/schemas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx --env-file=../../.env migrate.ts",
    "db:migrate:kit": "drizzle-kit migrate --config drizzle.config.ts",
    "db:seed": "tsx --env-file=../../.env src/seed.ts",
    "db:seed:scf": "tsx --env-file=../../.env src/seed-scf-catalog.ts",
    "db:seed:scf:dry-run": "tsx --env-file=../../.env src/seed-scf-catalog.ts --dry-run",
    "db:lifecycle-proof": "tsx --env-file=../../.env src/lifecycle-proof.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "vitest": "^3.2.3"
  }
}

