{
  "name": "@standard/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for the Standard API — SCF-based compliance intelligence platform",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
