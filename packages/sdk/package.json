{
  "name": "@standard/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for the Standard API — SCF-based compliance intelligence platform",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@standard/schemas": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
